#Rates of Elective and Urgent appy after NOM by site
```{r}
library(DescTools)
library(flextable)
library(officer)
NOM_patients$status365 <- factor(NOM_patients$status365, 0:2, c("None", "Elective", "Urgent/Emergent"))

appy_by_site <- table(NOM_patients$site_name, NOM_patients$status365)
appy_by_site


site_counts <- as.data.frame.matrix(appy_by_site) %>%
  tibble::rownames_to_column("site_name")

# Build gt table
gt(site_counts) %>%
  tab_header(
    title = "Appendectomy Status by Site",
    subtitle = "Counts of 365-day Status Categories"
  ) %>%
  fmt_number(
    columns = -site_name,
    decimals = 0
  ) %>%
  tab_style(
    style = cell_text(weight = "bold"),
    locations = cells_column_labels(everything())
  )


# relative percentages of elective, urgent, none for each site
percentages <- PercTable(site_name ~ status365, data = NOM_patients, rfrq = "010")
percentages


percent_df <- NOM_patients %>%
  count(site_name, status365) %>%
  group_by(site_name) %>%
  mutate(Percentage = n / sum(n)) %>%
  ungroup() %>%
  select(-n) %>%
  pivot_wider(
    names_from = status365,
    values_from = Percentage
  )


percent_df %>%
  gt(rowname_col = "site_name") %>%
  tab_header(
    title = "Appendectomy Type by Site"
  ) %>%
  fmt_percent(
    columns = -site_name,
    decimals = 1
  ) %>%
  cols_label(
    site_name = "Appendectomy Type"
  )


percent_df <- NOM_patients %>%
  count(site_name, status365) %>%
  group_by(site_name) %>%
  mutate(
    pct = n / sum(n),
    display = paste0(n, " (", scales::percent(pct, accuracy = 0.1), ")")
  ) %>%
  ungroup() %>%
  select(site_name, status365, display) %>%
  pivot_wider(
    names_from = status365,
    values_from = display
  ) %>%
  rename(Site = site_name)

percent_df

ft <- flextable(percent_df) %>%
  theme_vanilla() %>%
  autofit()

# Save the flextable as a PNG image
save_as_image(ft, path = "percent_table.png")
```
